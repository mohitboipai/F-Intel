# ─────────────────────────────────────────────────────────────────────────
# F-Intel Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────

# Fyers API Credentials
FYERS_APP_ID=your_fyers_app_id_here
FYERS_SECRET=your_fyers_secret_here
FYERS_REDIRECT_URI=https://your-callback-url.com
# FYERS_ACCESS_TOKEN=   # Optional: pre-existing token (skips interactive auth)

# Dashboard Authentication
# Set a strong random token (32+ chars). All API requests must include:
#   Header: X-FIntel-Token: <value>   OR   Query: ?token=<value>
# Leave blank to disable auth (local only use).
FINTEL_TOKEN=change_me_to_a_strong_random_secret_32chars

# Server Config
PORT=8082
FLASK_ENV=production

# Cloudflare Named Tunnel (optional — only needed for fixed tunnel URL)
# Leave blank to use the quick anonymous tunnel in docker-compose.
CLOUDFLARE_TUNNEL_TOKEN=

# DigitalOcean Deployment (used by deploy_do.sh)
DO_DROPLET_IP=your.droplet.ip.here
DO_SSH_USER=root
